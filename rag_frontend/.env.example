# Harry Potter LinearRAG frontend configuration

RAG_DATASET=harrypotter
RAG_EMBEDDING_MODEL=model/all-mpnet-base-v2
RAG_EMBEDDING_DEVICE=cuda
RAG_SPACY_MODEL=en_core_web_trf
RAG_QA_MODEL=qwen2.5:7b
RAG_TOP_K=8
RAG_ENABLE_CHAPTER_RETRIEVAL=1
RAG_CHAPTER_TOP_K=8
RAG_CHAPTER_GLOBAL_FALLBACK=2
RAG_LLM_MAX_TOKENS=128
RAG_REQUEST_TIMEOUT=240
RAG_AUTO_LOAD=1

OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5000
FRONTEND_DEBUG=0
